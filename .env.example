# Copy to .env (git-ignored) for local development. In production set these as
# real environment variables. Never commit real values.

# Required: password for /admin sign-in
ADMIN_PASSWORD=change-me

# Optional
# PORT=8787
# APP_URL=https://shop.example.com     # public origin, used in payment redirect/webhook URLs
# DATA_DIR=server/data                  # where nuri.db lives

# Paymob (Egypt) card / wallet — all four required to enable
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_INTEGRATION_IDS=card:123456,wallet:654321
# PAYMOB_HMAC=
# PAYMOB_BASE_URL=https://accept.paymob.com

# Bosta courier
# BOSTA_API_KEY=
# BOSTA_BASE_URL=https://app.bosta.co/api/v2

# WhatsApp Cloud API (Meta)
# WA_TOKEN=
# WA_PHONE_ID=
# WA_API_VERSION=v21.0
